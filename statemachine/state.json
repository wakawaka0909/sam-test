{
  "Comment": "ZIP Split and Parallel Process Workflow - Debug Mode",
  "QueryLanguage": "JSONata",
  "StartAt": "SplitTask",
  "States": {
    "SplitTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:ap-northeast-1:678135951842:function:testttttttttt-split",
        "Payload": "{% $states.input %}"
      },
      "Next": "Map",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "BackoffRate": 2,
          "IntervalSeconds": 1,
          "MaxAttempts": 1
        }
      ]
    },
    "Map": {
      "Type": "Map",
      "Items": "{% $states.input.Payload.items %}",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        },
        "StartAt": "変数設定",
        "States": {
          "変数設定": {
            "Type": "Pass",
            "Next": "DBImportTask",
            "Assign": {
              "split_path": "{% $states.input.split_path %}",
              "src_path": "{% $states.input.src_path %}",
              "table_name": "{% $states.input.table_name %}"
            }
          },
          "DBImportTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "arn:aws:lambda:ap-northeast-1:678135951842:function:testttttttttt-simulation",
              "Payload": "{% $states.input %}"
            },
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "FinalPass",
                "Assign": {
                  "failed_state": "DBImportTask"
                }
              }
            ],
            "Next": "CleansingTask",
            "Retry": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "BackoffRate": 2,
                "IntervalSeconds": 1,
                "MaxAttempts": 1
              }
            ]
          },
          "CleansingTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Arguments": {
              "FunctionName": "arn:aws:lambda:ap-northeast-1:678135951842:function:testttttttttt-simulation:$LATEST",
              "Payload": "{% $states.input.Payload %}"
            },
            "Retry": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 1,
                "BackoffRate": 2,
                "JitterStrategy": "FULL"
              }
            ],
            "Next": "FinalPass",
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "FinalPass",
                "Assign": {
                  "failed_state": "CleansingTask"
                }
              }
            ]
          },
          "FinalPass": {
            "Type": "Pass",
            "End": true,
            "Output": {
              "status": "{% $exists($states.input.Payload) ? 'SUCCESS' : 'FAILED' %}",
              "テーブル名": "{% $table_name %}",
              "元ファイルパス": "{% $src_path %}",
              "分割ファイルパス": "{% $split_path %}",
              "失敗した工程": "{% $exists($failed_state) ? $failed_state : 'なし' %}"
            }
          }
        }
      },
      "ToleratedFailurePercentage": 100,
      "Next": "EndTask"
    },
    "EndTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Output": "{% $states.result.Payload %}",
      "Arguments": {
        "FunctionName": "arn:aws:lambda:ap-northeast-1:678135951842:function:testttttttttt-End:$LATEST",
        "Payload": "{% $states.input %}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "End": true
    }
  }
}